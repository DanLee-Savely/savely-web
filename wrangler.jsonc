{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "savely-web",
	// 이 프로젝트가 받는 경로만 연다(도메인의 다른 경로는 건드리지 않음, 00-decisions F8 · M12)
	// /app* : 정확 일치 /app은 쿼리가 붙은 /app?_rsc=… 를 받지 못해(522) 홈 이동이 깨진다
	"routes": [
		{ "pattern": "www.savelyglobal.com/home*", "zone_name": "savelyglobal.com" },
		{ "pattern": "www.savelyglobal.com/app*", "zone_name": "savelyglobal.com" },
		{ "pattern": "www.savelyglobal.com/_next/*", "zone_name": "savelyglobal.com" },
		{ "pattern": "www.savelyglobal.com/robots.txt", "zone_name": "savelyglobal.com" },
		{ "pattern": "www.savelyglobal.com/sitemap.xml", "zone_name": "savelyglobal.com" }
	],
	// *.workers.dev · 미리보기 주소를 열지 않는다(도메인 규칙을 우회하는 입구, 보안 점검 2026-10-31)
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-10-28",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "savely-web"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// 출시 알림 API: 같은 IP 1분 5회 (30-waitlist §2). 지역별 근사치 — 엄격한 전역 한도가 필요하면 Durable Objects
	"ratelimits": [
		{
			"name": "WAITLIST_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		// 기록 체험판 쓰기(등록 · 수정 · 삭제): 같은 IP 1분 10회 (70-mvp-records M15)
		{
			"name": "RECORDS_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	// 출시 알림 저장소 (30-waitlist §4). 표는 migrations/ — wrangler d1 migrations apply savely-waitlist --remote
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "savely-waitlist",
			"database_id": "312fb3a0-662c-487f-915a-5a7130512bd5",
			"migrations_dir": "migrations"
		},
		// 기록 체험판 (70-mvp-records §6). 개인정보가 든 출시 알림 DB와 나눈다 — wrangler d1 migrations apply savely-records
		{
			"binding": "RECORDS_DB",
			"database_name": "savely-records",
			"database_id": "fddeac75-2b53-4375-829d-d5d2bf35e816",
			"migrations_dir": "migrations-records"
		}
	],
	// 기록 사진 (70-mvp-records §6-4). 공개 주소 없음 — /app/records/[id]/image 로만 전달
	"r2_buckets": [
		{ "binding": "RECORD_IMAGES", "bucket_name": "savely-record-images" }
	],
	"vars": {
		// 다른 출처에서 오는 신청 허용 목록. 쉼표로 구분. 지금은 없음(Vercel 사본을 만들지 않음, 00-decisions B6)
		"WAITLIST_ALLOWED_ORIGINS": ""
	}
}