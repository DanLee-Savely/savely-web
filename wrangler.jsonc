{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "savely-web",
	"routes": [{ "pattern": "www.savelyglobal.com/home*", "zone_name": "savelyglobal.com" }],
	"compatibility_date": "2026-10-28",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "savely-web"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// 출시 알림 API: 같은 IP 1분 5회 (30-waitlist §2). 지역별 근사치 — 엄격한 전역 한도가 필요하면 Durable Objects
	"ratelimits": [
		{
			"name": "WAITLIST_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	// 출시 알림 저장소 (30-waitlist §4). 표는 migrations/ — wrangler d1 migrations apply savely-waitlist --remote
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "savely-waitlist",
			"database_id": "312fb3a0-662c-487f-915a-5a7130512bd5",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// 다른 출처(Vercel 배포본)에서 오는 신청 허용 목록. 쉼표로 구분. Vercel 주소가 정해지면 넣는다
		"WAITLIST_ALLOWED_ORIGINS": ""
	}
}